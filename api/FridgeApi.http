@FridgeApi_HostAddress = http://localhost:5080

### Create an account (also logs in). Run this or "Log in" first: the other requests need the login cookie.
POST {{FridgeApi_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "name": "Test User",
  "phone": "+91 98765 43210",
  "email": "test@example.com",
  "password": "secret123"
}

### Log in
POST {{FridgeApi_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "secret123"
}

### Who is logged in
GET {{FridgeApi_HostAddress}}/api/auth/me

### Log out
POST {{FridgeApi_HostAddress}}/api/auth/logout

### List all items (soonest expiry first)
GET {{FridgeApi_HostAddress}}/api/items
Accept: application/json

### List the categories
GET {{FridgeApi_HostAddress}}/api/categories
Accept: application/json

### Add an item
POST {{FridgeApi_HostAddress}}/api/items
Content-Type: application/json

{
  "name": "Milk",
  "quantity": 1,
  "category": "Dairy",
  "expiryDate": "2026-11-22"
}

### Delete an item
DELETE {{FridgeApi_HostAddress}}/api/items/1
